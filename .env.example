# ============================================================================
# LP2443PSA Text-to-Label Printer Configuration (.env)
# ============================================================================

# --- Hardware / Printer Settings ---
# Path to printer device node ("auto" automatically finds QinHeng 1a86:7584 or /dev/lp2443)
LP2443_DEVICE_PATH=auto
LP2443_USB_VENDOR_ID=1a86
LP2443_USB_PRODUCT_ID=7584

# Label dimensions in dots at 203 DPI (4" x 6" = 812 x 1218, gap = 24 dots)
LP2443_LABEL_WIDTH_DOTS=812
LP2443_LABEL_HEIGHT_DOTS=1218
LP2443_GAP_DOTS=24

# Print speed (1-4 for LP2443) and darkness/density (0-15)
LP2443_SPEED=2
LP2443_DENSITY=10

# Set to true only if your LP2443 firmware prints negative/inverted bitmaps
LP2443_INVERT_BITMAP=false

# --- Web UI & HTTP / Webhook Server ---
LP2443_HOST=0.0.0.0
LP2443_PORT=8000
# Optional secret token for /api/print and /webhook/sms (leave blank to allow LAN without token)
LP2443_API_KEY=

# --- Telegram Bot (Cheapest, Easiest, Most Secure Remote Texting) ---
# Get a token from @BotFather on Telegram
LP2443_TELEGRAM_BOT_TOKEN=
# Comma-separated list of numeric Telegram User IDs allowed to print (e.g. 123456789,987654321)
# Leave empty during first test to allow the bot to tell you your numeric User ID
LP2443_TELEGRAM_ALLOWED_USER_IDS=
